{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fovea",
  "version": "1.0.0",
  "identifier": "com.fovea.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fovea",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Fovea",
    "homepage": "https://fovea.caelmont.in",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "models/*": "models/"
    },
    "category": "Productivity",
    "shortDescription": "Local AI image enhancement",
    "longDescription": "Fovea enhances and upscales your photos with a local AI model. Every image is processed on your own machine and never uploaded.",
    "copyright": "© 2026 Fovea",
    "license": "LicenseRef-Fovea",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
