# Fovea website — configuration (copy to .env.local; never commit secrets)
#
# Everything here is read SERVER-SIDE only. Nothing in this file is shipped to
# the browser. The license SIGNING key is never here at all — keys are issued
# by the vendor tool (src-tauri/examples/issue_license.rs), and the desktop app
# embeds only PUBLIC keys via FOVEA_LICENSE_PUBKEYS at Rust build time.

# ── Supabase (orders + license fulfillment backend) ───────────────────
# See website/BACKEND.md for the full setup (schema.sql goes into the SQL
# Editor once). The anon key is for future browser use; every current call
# is server-side and uses the service_role key, which must NEVER be exposed.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_..._or_legacy_anon_jwt
SUPABASE_SERVICE_ROLE_KEY=

# ── Payment / delivery ────────────────────────────────────────────────
# Which checkout provider the /api/checkout route uses. The default, "manual",
# needs no secret and no network: it sends the buyer to /download (the honest
# pre-processor launch path). "stripe" runs Stripe Checkout + the webhook at
# /api/webhooks/stripe; it fails loudly if its secrets are missing.
FOVEA_PAYMENT_PROVIDER=manual

# Stripe (SECRET, server-side only):
# FOVEA_STRIPE_SECRET_KEY=sk_live_...
# Optional pre-created Price ids; without them prices are created inline
# from the amounts below (in USD):
# FOVEA_STRIPE_PRICE_PRO=price_...
# FOVEA_STRIPE_PRICE_STUDIO=price_...
# FOVEA_STRIPE_AMOUNT_PRO_USD=49
# FOVEA_STRIPE_AMOUNT_STUDIO_USD=129
# Webhook signing secret (dashboard → Developers → Webhooks):
# FOVEA_STRIPE_WEBHOOK_SECRET=whsec_...

# ── Installer download (published artifact) ───────────────────────────
# The URL the app bundle (NSIS .exe / MSI from `tauri build`) is uploaded to.
# Leave FOVEA_DOWNLOAD_URL unset before launch and the site will honestly show
# "not published yet" instead of a broken link.
# FOVEA_DOWNLOAD_URL=https://downloads.caelmont.in/Fovea_1.0.0_x64-setup.exe
# FOVEA_DOWNLOAD_VERSION=1.0.0
# FOVEA_DOWNLOAD_SIZE=58 MB

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin for absolute URLs (sitemap, OG) lives in lib/site.ts, currently https://fovea.caelmont.in.

