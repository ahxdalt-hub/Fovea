# Pixora website — configuration (copy to .env.local; never commit secrets)
#
# Everything here is read SERVER-SIDE only. Nothing in this file is shipped to
# the browser. The license SIGNING key is never here at all — keys are issued
# by the vendor tool (src-tauri/examples/issue_license.rs), and the desktop app
# embeds only PUBLIC keys via PIXORA_LICENSE_PUBKEYS at Rust build time.

# ── Payment / delivery ────────────────────────────────────────────────
# Which checkout provider the /api/checkout route uses. The default, "manual",
# needs no secret and no network: it sends the buyer to /download (the honest
# pre-processor launch path). A real processor gets its own adapter in
# lib/providers/* and its own API key below — added only when you wire it.
PIXORA_PAYMENT_PROVIDER=manual

# Example of the shape a future adapter would read (leave commented until the
# provider is actually connected; these are SECRET and stay server-side):
# PIXORA_STRIPE_SECRET_KEY=sk_live_...
# PIXORA_STRIPE_PRICE_PRO=price_...
# PIXORA_STRIPE_PRICE_STUDIO=price_...

# ── Installer download (published artifact) ───────────────────────────
# The URL the app bundle (NSIS .exe / MSI from `tauri build`) is uploaded to.
# Leave PIXORA_DOWNLOAD_URL unset before launch and the site will honestly show
# "not published yet" instead of a broken link.
# PIXORA_DOWNLOAD_URL=https://downloads.pixora.app/Pixora_0.1.0_x64-setup.exe
# PIXORA_DOWNLOAD_VERSION=0.1.0
# PIXORA_DOWNLOAD_SIZE=58 MB

# ── Site ──────────────────────────────────────────────────────────────
# Canonical origin used for absolute URLs (sitemap, OG). Defaults to pixora.app.
# NEXT_PUBLIC_SITE_URL=https://pixora.app
