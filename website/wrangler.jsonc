{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fovea-website",
  "main": ".open-next/worker.js",
  "account_id": "263638586a79f58c60922fe09323935b",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Server-side only — never exposed to the browser.
  //
  // SECRETS are not vars — set them once per environment:
  //   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  //   wrangler secret put FOVEA_STRIPE_SECRET_KEY
  //   wrangler secret put FOVEA_STRIPE_WEBHOOK_SECRET
  // (OpenNext exposes vars + secrets to the worker as process.env.)
  "vars": {
    "FOVEA_PAYMENT_PROVIDER": "manual",
    "SUPABASE_URL": "https://ulpwhvfqhfbrjbjbvivz.supabase.co",
    "FOVEA_DOWNLOAD_VERSION": "1.2.0",
    "FOVEA_DOWNLOAD_URL": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-1.2.0-x64.exe",
    "FOVEA_DOWNLOAD_MSI_URL": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-1.2.0-x64.msi",
    "FOVEA_DOWNLOAD_SIZE": "16 MB",
    "FOVEA_DOWNLOAD_URL_PRO": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-Pro-1.2.0-x64.exe",
    "FOVEA_DOWNLOAD_MSI_URL_PRO": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-Pro-1.2.0-x64.msi",
    "FOVEA_DOWNLOAD_SIZE_PRO": "16 MB",
    "FOVEA_DOWNLOAD_URL_STUDIO": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-Studio-1.2.0-x64.exe",
    "FOVEA_DOWNLOAD_MSI_URL_STUDIO": "https://github.com/ahxdalt-hub/Fovea/releases/download/v1.2.0/Fovea-Studio-1.2.0-x64.msi",
    "FOVEA_DOWNLOAD_SIZE_STUDIO": "16 MB",
  },
  "routes": [
    {
      "pattern": "fovea.caelmont.in",
      "custom_domain": true,
      "zone_id": "92a841adaa6883716e87795e513d2cf1",
    },
  ],
}
